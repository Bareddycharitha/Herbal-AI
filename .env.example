# =============================================================================
# Herbal-AI — Repository-root environment template
# =============================================================================
# This file is a convenience copy of `backend/.env.example`. Pydantic-Settings
# loads `.env` from the current working directory; if you start the backend
# with `uvicorn` from this directory, the values here will be picked up
# automatically. If you start it from `backend/`, the file there takes
# precedence.
# =============================================================================

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=false
ENVIRONMENT=development

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST
CORS_ALLOW_HEADERS=*

# ---------- Security ----------
SECRET_KEY=dev-insecure-secret-key-change-in-production

# ---------- Clerk ----------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
