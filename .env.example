# ============================================================
# Supabase (database only - no Supabase Auth)
# ============================================================
# Get these from your Supabase project dashboard:
# Project Settings > API > URL and Keys
#
# SUPABASE_URL: Your project's Supabase URL
# SUPABASE_ANON_KEY: Your project's anon (public) key
# SUPABASE_SERVICE_ROLE_KEY: Your project's service role (secret) key
#
# NEVER commit these to version control. Use environment variables in production.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Clerk Authentication
# ============================================================
# Get these from your Clerk dashboard:
# https://dashboard.clerk.com/
#
# CLERK_PUBLISHABLE_KEY: Your Clerk publishable key
# CLERK_SECRET_KEY: Your Clerk secret key
# CLERK_JWKS_URL: Your Clerk JWKS URL
#   Format: https://<your-domain>.clerk.accounts.dev/.well-known/jwks.json
#
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: Public key for frontend
#
# NEVER commit these to version control. Use environment variables in production.

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ============================================================
# OpenRouter LLM Configuration
# ============================================================
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use for LLM features (chatbot, summaries)
# See https://openrouter.ai/models for available options
OPENROUTER_MODEL=google/gemini-flash-1.5

# Request timeout in seconds
OPENROUTER_TIMEOUT_SECONDS=120

# Maximum number of retry attempts
OPENROUTER_MAX_RETRIES=3

# Backoff multiplier for exponential retry (seconds)
OPENROUTER_RETRY_BACKOFF=1.0

# Optional: HTTP Referer header for OpenRouter analytics
OPENROUTER_HTTP_REFERER=

# Optional: Application name for OpenRouter analytics
OPENROUTER_APP_NAME=Herbal-AI

